rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTime(value) {
      return value is string && value.matches('^([0-1][0-9]|2[0-3]):[0-5][0-9]$');
    }

    match /slotLocks/{docId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['date', 'createdAt']) &&
        isValidDate(request.resource.data.date) &&
        request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    match /availability/{docId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['date', 'time', 'durationHours', 'createdAt']) &&
        isValidDate(request.resource.data.date) &&
        isValidTime(request.resource.data.time) &&
        request.resource.data.durationHours in [1, 2] &&
        request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    match /bookings/{docId} {
      allow read: if request.auth != null;
      allow create: if
        request.resource.data.keys().hasOnly(['date', 'time', 'durationHours', 'firstName', 'lastName', 'phone', 'createdAt', 'availabilityId']) &&
        isValidDate(request.resource.data.date) &&
        isValidTime(request.resource.data.time) &&
        request.resource.data.durationHours in [1, 2] &&
        request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 40 &&
        request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 40 &&
        request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 10 &&
        request.resource.data.createdAt is string &&
        request.resource.data.availabilityId is string;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    match /messages/{docId} {
      allow read: if false;
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'message', 'createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 500 &&
        request.resource.data.createdAt is string;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}