rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTime(value) {
      return value is string && value.matches('^([0-1][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isValidName(value) {
      return value is string && value.matches('^[\\p{L} \'-]{2,40}$');
    }

    function isValidPhone(value) {
      return value is string && value.matches('^[0-9]{10}$');
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Legacy availability/slotLocks docs created before ownership tagging lack
    // `userId`; they remain deletable by any authenticated user until they age
    // out, so existing users can still cancel bookings made before this change.
    function canManageSlot(data) {
      return isAdmin() ||
        (request.auth != null && (!('userId' in data) || data.userId == request.auth.uid));
    }

    match /slotLocks/{docId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['date', 'createdAt', 'userId']) &&
        isValidDate(request.resource.data.date) &&
        request.resource.data.createdAt is string &&
        request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if canManageSlot(resource.data);
    }

    match /availability/{docId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['date', 'time', 'durationHours', 'createdAt', 'userId']) &&
        isValidDate(request.resource.data.date) &&
        isValidTime(request.resource.data.time) &&
        request.resource.data.durationHours in [1, 2] &&
        request.resource.data.createdAt is string &&
        request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if canManageSlot(resource.data);
    }

    match /bookings/{docId} {
      allow read: if request.auth != null &&
        (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['date', 'time', 'durationHours', 'firstName', 'lastName', 'phone', 'createdAt', 'availabilityId', 'userId']) &&
        isValidDate(request.resource.data.date) &&
        isValidTime(request.resource.data.time) &&
        request.resource.data.durationHours in [1, 2] &&
        isValidName(request.resource.data.firstName) &&
        isValidName(request.resource.data.lastName) &&
        isValidPhone(request.resource.data.phone) &&
        request.resource.data.createdAt is string &&
        request.resource.data.availabilityId is string &&
        request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.userId);
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['firstName', 'lastName', 'phone', 'email', 'createdAt']) &&
        isValidName(request.resource.data.firstName) &&
        isValidName(request.resource.data.lastName) &&
        isValidPhone(request.resource.data.phone) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.createdAt is string;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'phone']) &&
        isValidName(request.resource.data.firstName) &&
        isValidName(request.resource.data.lastName) &&
        isValidPhone(request.resource.data.phone);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    match /messages/{docId} {
      allow read: if false;
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'message', 'createdAt']) &&
        isValidName(request.resource.data.name) &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 500 &&
        request.resource.data.createdAt is string;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}